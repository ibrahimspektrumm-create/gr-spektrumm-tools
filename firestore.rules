rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function myRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function isAdmin() {
      return isSignedIn() && myRole() == 'admin';
    }
    function isManager() {
      return isSignedIn() && myRole() == 'manager';
    }
    function isAdminOrManager() {
      return isAdmin() || isManager();
    }
    function isOwner(resourceData) {
      return isSignedIn() && resourceData.ownerId == request.auth.uid;
    }
    function isAssignedOrCreator(taskData) {
      return isSignedIn() &&
        (taskData.createdBy == request.auth.uid ||
         (request.auth.uid in taskData.assignedTo));
    }

    // ---------- users ----------
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isAdmin();
      // Users may only update their own non-role fields; role changes require admin.
      allow update: if isAdmin() ||
        (isSignedIn() && request.auth.uid == userId &&
         request.resource.data.role == resource.data.role);
      allow delete: if isAdmin();
    }

    // ---------- tasks ----------
    match /tasks/{taskId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        (isAdminOrManager() ||
         (request.resource.data.assignedTo.size() == 1 &&
          request.auth.uid in request.resource.data.assignedTo));
      allow update: if isSignedIn() &&
        (isAdminOrManager() || isAssignedOrCreator(resource.data));
      allow delete: if isAdmin() || (isSignedIn() && resource.data.createdBy == request.auth.uid);
    }

    // ---------- taskComments ----------
    match /taskComments/{commentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update: if false;
      allow delete: if isAdmin() ||
        (isSignedIn() && resource.data.authorId == request.auth.uid);
    }

    // ---------- taskChats ----------
    match /taskChats/{chatId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // ---------- generalChat ----------
    match /generalChat/{docId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // ---------- notifications ----------
    match /notifications/{notifId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if isAdmin();
    }

    // ---------- tools ----------
    match /tools/{toolId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isAdmin() || isOwner(resource.data);
    }

    // ---------- excelFiles ----------
    match /excelFiles/{fileId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isAdmin() || isOwner(resource.data);
    }

    // ---------- solutions ----------
    match /solutions/{solId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isAdmin() || isOwner(resource.data);
    }

    // ---------- guides ----------
    match /guides/{guideId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isAdmin() || isOwner(resource.data);
    }

    // ---------- favorites ----------
    match /favorites/{favId} {
      allow read, write: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
