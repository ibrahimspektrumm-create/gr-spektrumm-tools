rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    // Excel / data files: <=200MB, spreadsheet/CSV mime types, owner folder pattern.
    match /excelFiles/{ownerId}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() &&
        request.auth.uid == ownerId &&
        request.resource.size < 200 * 1024 * 1024 &&
        request.resource.contentType.matches('application/.*|text/csv');
      allow delete: if isSignedIn();
    }

    // Uploaded HTML tool files: <=150MB, HTML mime type, owner folder pattern.
    match /toolFiles/{ownerId}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() &&
        request.auth.uid == ownerId &&
        request.resource.size < 150 * 1024 * 1024 &&
        request.resource.contentType.matches('text/html|text/plain|application/octet-stream');
      allow delete: if isSignedIn();
    }

    // Tool images: <=5MB, image mime types only.
    match /toolImages/{ownerId}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() &&
        request.auth.uid == ownerId &&
        request.resource.size < 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
      allow delete: if isSignedIn();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
